# 统一以 LF 存储，检出时按平台处理，避免 Windows 上出现 CRLF 噪声
* text=auto eol=lf

# 二进制资源不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mp3 binary
*.woff binary
*.woff2 binary
*.ttf binary
*.db binary
*.zip binary

# 文本类型显式声明
*.php  text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.md   text eol=lf
*.json text eol=lf

# 语言统计：排除前端依赖与数据库快照对语言占比的干扰
database/school.db binary linguist-vendored
assets/css/style.css linguist-vendored=false
